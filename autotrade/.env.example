# Alpaca paper credentials
ALPACA_API_KEY_ID=your_paper_key_id
ALPACA_API_SECRET_KEY=your_paper_secret_key
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Safety
DRY_RUN=true

# Strategy defaults
STRATEGY_SIGNAL_SYMBOL=QQQ
STRATEGY_VIX_SYMBOL=^VIX
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_BUY_BELOW=35
STRATEGY_TARGET_DELTA=0.70
STRATEGY_CONTRACT_TARGET_DAYS=730
STRATEGY_CONTRACT_DAY_TOLERANCE=120
STRATEGY_FORCE_EXIT_DAYS_TO_EXPIRY=180
STRATEGY_SHORT_CALL_DTE=30
STRATEGY_SHORT_CALL_OTM_PCT=0.10
STRATEGY_OPTION_FEED=indicative

# Optional local email notification. Leave disabled until SMTP is configured.
EMAIL_NOTIFY_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@example.com
SMTP_TO=your_email@example.com
